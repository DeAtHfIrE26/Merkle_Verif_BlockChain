# ---------------------------------------------------------------------------
# Merkle Verify — example environment file
#
# The web app requires NO environment variables to run. Every core feature is
# pure client-side computation. Everything below is OPTIONAL and only unlocks
# the on-chain verification path.
#
# Copy to `.env` and fill in if you want those extras. Never commit `.env`.
# Names and descriptions only — no real values, ever.
# ---------------------------------------------------------------------------

# --- Web app (apps/web) --------------------------------------------------

# Address of a deployed MerkleVerifier contract. When set, the Merkle
# Explorer additionally offers "verify on-chain" against this contract.
# Leave unset to run fully offline. Must be a 0x-prefixed 20-byte address.
NEXT_PUBLIC_MERKLE_VERIFIER_ADDRESS=

# EVM chain id the above contract is deployed on (e.g. 11155111 for Sepolia).
NEXT_PUBLIC_CHAIN_ID=

# --- Contract deployment (packages/contracts) ----------------------------
# Only needed if you deploy the contracts yourself. Never needed to compile
# or test locally — `npm run test:contracts` works with none of these set.

# JSON-RPC endpoint for the target network, e.g. an Infura or Alchemy URL.
SEPOLIA_RPC_URL=

# Private key of the deploying account, 0x-prefixed, 32 bytes.
# Use a throwaway deployment key that holds only testnet funds.
PRIVATE_KEY=

# Address of an already-deployed MerkleVerifier, used by `setMerkleRoot`.
CONTRACT_ADDRESS=
