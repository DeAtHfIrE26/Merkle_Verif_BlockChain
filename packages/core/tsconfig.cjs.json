{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/cjs",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "isolatedModules": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "scripts/**/*"]
}
