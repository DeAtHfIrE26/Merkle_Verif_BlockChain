{
  "name": "@merkle-verify/core",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-free Merkle tree and signature primitives, shared by the web app and the contract tests.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && node scripts/write-dist-manifests.mjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@openzeppelin/merkle-tree": "^1.0.8",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
